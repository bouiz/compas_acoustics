                    <item name="control_inputs_hidden" type_name="gh_string" type_code="10">ism_order</item>
                    <item name="control_inputs_shown" type_name="gh_bool" type_code="1">false</item>
                    <item name="control_value_ism_order" type_name="gh_string" type_code="10">3</item>
                  </items>
