                    <chunk name="param_input" index="1">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">Add ray tracing after the image sources (default True). Off: image sources only. Materials without scattering coefficients scatter 0.05.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">21b5bf1d-8da0-4c46-aa83-9f30b6422bc4</item>
