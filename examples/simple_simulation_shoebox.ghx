                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">Seed of the ray tracing, 42 as in the method: the same seed gives the same responses, another number another realisation of the rays. Ray tracing only.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">77b3e1ca-ad4a-40cc-980d-ca24ac2d994b</item>
                        <item name="Name" type_name="gh_string" type_code="10">seed</item>
