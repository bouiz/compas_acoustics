                    <chunk name="param_output" index="0">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">One branch per chosen source-receiver pair, path {receiver;source}: the auralised signal in the format of its impulse response, shaped (samples, channels). The Audio Player plays mono (on both channels) and binaural; ambisonic signals are for saving.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">c830eccc-1360-425c-bc8a-49359f7cc8ca</item>
                        <item name="Name" type_name="gh_string" type_code="10">signals</item>
